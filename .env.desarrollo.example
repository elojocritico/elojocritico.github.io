# Configuracion del panel (/admin). Copia este fichero a .env y rellena los valores reales.
# Los valores PUBLIC_* acaban en el navegador: no pongas aqui nada secreto.

# Datos de la aplicacion web de Firebase (Consola de Firebase > Configuracion del proyecto), en una sola linea JSON.
# PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# Para trabajar contra el simulador local no hace falta nada de esto: `npm run admin:dev`
# pone estas dos variables por ti (config falsa con projectId "demo-elojocritico").
# PUBLIC_EMULADOR=1
# PUBLIC_FIREBASE_CONFIG={"projectId":"demo-elojocritico","apiKey":"demo"}
