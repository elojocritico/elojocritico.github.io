---
import type { Page } from "astro";
import Base from "../layouts/Base.astro";
import Tarjeta from "./Tarjeta.astro";
import Paginacion from "./Paginacion.astro";
import { secciones, anios, articulos, type Articulo } from "../lib/contenido";
interface Props { page: Page<Articulo>; titulo: string; temaActual?: string; anioActual?: number }
const { page, titulo, temaActual, anioActual } = Astro.props;
---
<Base titulo={titulo} actual="articulos">
  <section class="contenedor" style="padding-top:28px">
    <h1 class="seccion-titulo" style="font-size:14px">{titulo} · {page.total} artículos</h1>
    <div class="chips" style="margin-bottom:10px">
      <a href="/articulos/" aria-current={!temaActual && !anioActual ? "page" : undefined}>Todos</a>
      {secciones().map((s) => <a href={`/tema/${s.slug}/`} aria-current={s.slug === temaActual ? "page" : undefined}>{s.nombre}</a>)}
    </div>
    <div class="chips" style="margin-bottom:28px">
      {anios(articulos()).map((y) => <a href={`/anio/${y}/`} aria-current={y === anioActual ? "page" : undefined}>{y}</a>)}
    </div>
    <div class="rejilla">{page.data.map((a) => <Tarjeta articulo={a} extracto />)}</div>
    <Paginacion page={page} />
  </section>
</Base>
