---
import { fechaLarga, nombreSeccion, type Articulo } from "../lib/contenido";
import { portadaDe, UMBRAL_TARJETA } from "../lib/fotos";
import Foto from "./Foto.astro";
interface Props { articulo: Articulo; extracto?: boolean }
const { articulo: a, extracto = false } = Astro.props;
const portada = portadaDe(a);
---
<a class="tarjeta" href={`/${a.slug}/`}>
  <div class="imagen rayas">{portada && <Foto src={portada.tarjeta} alt={portada.alt} ancho={portada.anchoTarjeta} umbral={UMBRAL_TARJETA} lazy width={640} height={360} />}</div>
  {a.secciones[0] && <div class="etiqueta">{nombreSeccion(a.secciones[0])}</div>}
  <h3>{a.titulo}</h3>
  <div class="meta">{fechaLarga(a.fecha)}</div>
  {extracto && <p>{a.extracto}</p>}
</a>
