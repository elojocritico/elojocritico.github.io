rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de autorizados: ajustes/global.usuarios = { correo: "admin" | "editor" }
    function ajustes() {
      return get(/databases/$(database)/documents/ajustes/global).data;
    }
    function conSesion() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/ajustes/global);
    }
    function papel() {
      return ajustes().get('usuarios', {}).get(request.auth.token.email.lower(), '');
    }
    function autorizado() { return conSesion() && papel() != ''; }
    function esAdmin() { return autorizado() && papel() == 'admin'; }
    function esEditor() { return autorizado() && (papel() == 'editor' || papel() == 'admin'); }

    // Articulos: editores y admins leen y escriben; borrar del todo solo lo hace un admin y solo desde la papelera.
    // Las versiones son solo de alta; unicamente un admin las borra, junto con su articulo ya en la papelera.
    match /articulos/{id} {
      allow read, create, update: if esEditor();
      allow delete: if esAdmin() && resource.data.get('estado', '') == 'papelera';
      match /versiones/{v} {
        allow create, read: if esEditor();
        allow update: if false;
        allow delete: if esAdmin()
          && get(/databases/$(database)/documents/articulos/$(id)).data.get('estado', '') == 'papelera';
      }
    }

    // Indice ligero de titulos para buscar: lo escribe el exportador (servidor), nunca un cliente.
    match /indices/{nombre} {
      allow read: if esEditor();
      allow write: if false;
    }

    // Comentarios: el publico solo crea comentarios pendientes y validados.
    match /comentarios/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['articuloSlug', 'nombre', 'correo', 'texto', 'respuestaA', 'estado', 'origen', 'creadoEn'])
        && request.resource.data.keys().hasAll(
            ['articuloSlug', 'nombre', 'correo', 'texto', 'respuestaA', 'estado', 'origen', 'creadoEn'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.origen == 'nuevo'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 60
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 3000
        && request.resource.data.correo is string
        && request.resource.data.correo.size() <= 120
        && request.resource.data.articuloSlug is string
        && request.resource.data.articuloSlug.matches('^[^/]{1,200}$')
        && (request.resource.data.respuestaA == null
          || (request.resource.data.respuestaA is string
              && request.resource.data.respuestaA.matches('^[A-Za-z0-9_-]{1,64}$')))
        && request.resource.data.creadoEn == request.time;
      allow read, delete: if esEditor();
      allow update: if esEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado in ['pendiente', 'aprobado', 'rechazado', 'spam'];
    }

    // Comentarios del archivo ocultados: ids = lista de ocultos (la cambian los editores desde el panel).
    // El texto original de cada oculto vive en archivoOcultos/{slug}/textos/{id}: lo escribe solo el exportador (servidor).
    // Un cliente no puede borrar estos documentos (se perdería la lista) ni tocar textos.
    match /archivoOcultos/{slug} {
      allow read: if esEditor();
      allow create: if esEditor()
        && request.resource.data.keys().hasOnly(['ids'])
        && request.resource.data.ids is list;
      allow update: if esEditor()
        && request.resource.data.keys().hasOnly(['ids'])
        && request.resource.data.ids is list;
      allow delete: if false;
      match /textos/{id} {
        allow read: if esEditor();
        allow write: if false;
      }
    }

    // Lapidas de articulos borrados del todo: las crea el admin al borrar y las lee el exportador (servidor) para retirar la pagina.
    match /borrados/{slug} {
      allow read: if esEditor();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['borradoEn', 'borradoPor'])
        && request.resource.data.borradoEn is string
        && request.resource.data.borradoPor is string;
      // Si la direccion se reutilizo y se borra otra vez, el panel actualiza la lapida (misma forma exacta). Nadie la borra desde un cliente.
      allow update: if esAdmin()
        && request.resource.data.keys().hasOnly(['borradoEn', 'borradoPor'])
        && request.resource.data.borradoEn is string
        && request.resource.data.borradoPor is string;
      allow delete: if false;
    }

    // Valores de ajustes/global que acaban en la web publica: se vuelven a comprobar aqui (y otra vez en la web).
    // Cada enlace debe ser http(s); las reglas no pueden recorrer listas, asi que eso lo comprueban el panel y la web.
    function ajustesValidos() {
      let d = request.resource.data;
      return (!('enlaces' in d) || (d.enlaces is list && d.enlaces.size() <= 20))
        && (!('adsense' in d) || (d.adsense is map
          && d.adsense.activo is bool
          && d.adsense.cliente is string && (d.adsense.cliente == '' || d.adsense.cliente.matches('^ca-pub-[0-9]{16}$'))
          && d.adsense.bloque is string && (d.adsense.bloque == '' || d.adsense.bloque.matches('^[0-9]{10}$'))));
    }

    // Ajustes: leen los autorizados, escribe solo el admin (incluye usuarios).
    match /ajustes/global {
      allow read: if autorizado();
      // Sin create/delete desde el cliente; siempre debe quedar algun admin.
      allow update: if esAdmin()
        && request.resource.data.usuarios.values().hasAny(['admin'])
        && ajustesValidos();
    }

    // Estado: los editores solo pueden cambiar publicarPendiente y publicarPendienteEn (cuándo lo pidieron).
    match /estado/sistema {
      allow read: if autorizado();
      allow update: if esEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicarPendiente', 'publicarPendienteEn'])
        && request.resource.data.publicarPendiente is bool
        && (!('publicarPendienteEn' in request.resource.data) || request.resource.data.publicarPendienteEn is string);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
